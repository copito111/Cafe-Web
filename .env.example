# Backend runtime configuration (copy to backend/.env for local development)
APP_ENV=local
APP_DEBUG=false
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# MySQL. Use a dedicated, least-privilege application account.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cafe_web
DB_USERNAME=cafe_web
DB_PASSWORD=replace_with_a_local_secret
DB_CHARSET=utf8mb4

# Generate a long random value outside source control before implementation.
SESSION_SECRET=replace_with_a_random_secret